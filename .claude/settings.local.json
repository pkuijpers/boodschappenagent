{
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv sync:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(find:*)",
      "mcp__puppeteer__puppeteer_connect_active_tab",
      "mcp__puppeteer__puppeteer_screenshot",
      "Bash(uv run python:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(test:*)",
      "Bash(git fetch origin main)",
      "Bash(git rebase origin/main)",
      "Bash(ruff check:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "puppeteer"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/pieter/projects/albert/agent-backend && uv run ruff check --fix $(echo $CLAUDE_TOOL_INPUT | jq -r '.file_path // empty') 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
