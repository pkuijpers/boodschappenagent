{
  "permissions": {
    "allow": [
      "Task",
      "Bash(python3:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv sync:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(find:*)",
      "mcp__puppeteer__puppeteer_connect_active_tab",
      "mcp__puppeteer__puppeteer_screenshot",
      "Bash(uv run python:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(test:*)",
      "Bash(git fetch origin main)",
      "Bash(git rebase origin/main)",
      "Bash(ruff check:*)",
      "mcp__puppeteer__puppeteer_navigate",
      "mcp__puppeteer__puppeteer_click",
      "mcp__puppeteer__puppeteer_fill",
      "mcp__puppeteer__puppeteer_evaluate",
      "Bash(xargs basename:*)",
      "Bash(git -C:*)",
      "Bash(bash .specify/extensions/git/scripts/bash/auto-commit.sh after_constitution)",
      "Bash(bash .specify/extensions/git/scripts/bash/auto-commit.sh after_plan)",
      "Bash(bash .specify/extensions/git/scripts/bash/auto-commit.sh after_implement)",
      "Bash(bash .specify/extensions/git/scripts/bash/create-new-feature.sh --json *)",
      "Bash(bash .specify/scripts/bash/check-prerequisites.sh *)",
      "Bash(bash .specify/scripts/bash/setup-plan.sh --json)",
      "Bash(bash .specify/scripts/bash/setup-tasks.sh --json)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "puppeteer"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/pieter/projects/albert/agent-backend && uv run ruff check --fix $(echo $CLAUDE_TOOL_INPUT | jq -r '.file_path // empty') 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
